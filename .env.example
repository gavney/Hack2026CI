# ==============================================================================
# ПРИМЕР КОНФИГУРАЦИОННОГО ФАЙЛА ОКРУЖЕНИЯ (.env.example)
# Сервис прогнозирования и предотвращения кассовых разрывов «Центр-Инвест»
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API ФЕДЕРАЛЬНОЙ НАЛОГОВОЙ СЛУЖБЫ (api-fns.ru)
# Личный кабинет для получения токена: https://api-fns.ru/user?cabinet&id=22722
# Методы: nalogbi (блокировки счетов ст. 76 НК РФ), check (факторы риска), egr, bo
# ------------------------------------------------------------------------------
FNS_API_KEY=your_api_fns_token_here

# ------------------------------------------------------------------------------
# 2. БЕЗОПАСНОСТЬ И АВТОРИЗАЦИЯ
# Секретный ключ для подписи JWT-токенов пользователей
# ------------------------------------------------------------------------------
SECRET_KEY=centroinvest-hack2026-secret-key-12345
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. БАЗА ДАННЫХ
# По умолчанию используется быстрая локальная база SQLite с режимом WAL.
# Для промышленного развертывания укажите PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/radar_db
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./radar.db

# ------------------------------------------------------------------------------
# 4. ПАРАМЕТРЫ ПРОГНОЗИРОВАНИЯ И МОНТЕ-КАРЛО
# ------------------------------------------------------------------------------
DEFAULT_HORIZON=30
MAX_HORIZON=90
CORRIDOR_FACTOR=1.28

# ------------------------------------------------------------------------------
# 5. ДИРЕКТОРИЯ ДЛЯ ЗАГРУЗКИ ВЫПИСОК И ФАЙЛОВ
# ------------------------------------------------------------------------------
DATA_DIR=./data

# ------------------------------------------------------------------------------
# 6. SMTP ШЛЮЗ ДЛЯ ОТПРАВКИ КОДОВ ПОДТВЕРЖДЕНИЯ (Yandex SSL)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=lebedev.andrey1303@yandex.ru
SMTP_PASSWORD=qwufrmrepifeebjx
SMTP_FROM_NAME="Банк Центр-инвест • Кассовый радар"
